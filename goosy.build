// Goosy — Goose Sidecar Build Configuration (docs/packages.md §3)
// Run ./scripts/build.sh first to generate Wayland xdg-shell protocol bindings
// under native/generated/ and verify pkg-config include paths on Artix Linux.

c_sources = [
    "native/goosy_pty.c",
    "native/goosy_poll.c",
    "native/goosy_xkb.c",
    "native/goosy_wayland.c",
    "native/goosy_font.c",
    "native/goosy_render.c",
    "native/goosy_image.c",
    "native/generated/xdg-shell-protocol.c",
    "native/generated/xdg-decoration-unstable-v1-protocol.c",
    "native/generated/primary-selection-unstable-v1-protocol.c",
    "native/generated/fractional-scale-v1-protocol.c",
    "native/generated/viewporter-protocol.c",
];

c_include = [
    "native",
    "native/generated",
    "/usr/include/pixman-1",
    "/usr/include/freetype2",
    "/usr/include/harfbuzz",
];

c_defines = [
    "_POSIX_C_SOURCE=200809L",
    "_GNU_SOURCE",
    "GOOSY_WITH_GOOSE_H=1",
];

c_flags_cc = [
    "-O3",
    "-fomit-frame-pointer",
    "-Wall",
    "-Wextra",
    "-std=c99",
];

c_libs_linux = [
    "wayland-client",
    "wayland-cursor",
    "pixman-1",
    "freetype",
    "fontconfig",
    "harfbuzz",
    "xkbcommon",
    "png",
    "m",
];

main_thread_only = true;
output = "goosy";
