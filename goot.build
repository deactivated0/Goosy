// Goot — Goose Sidecar Build Configuration (docs/packages.md §3)
// Run ./scripts/build.sh first to generate Wayland xdg-shell protocol bindings
// under native/generated/ and verify pkg-config include paths on Artix Linux.

c_sources = [
    "native/goot_pty.c",
    "native/goot_poll.c",
    "native/goot_xkb.c",
    "native/goot_wayland.c",
    "native/goot_font.c",
    "native/goot_render.c",
    "native/generated/xdg-shell-protocol.c",
    "native/generated/xdg-decoration-unstable-v1-protocol.c",
    "native/generated/primary-selection-unstable-v1-protocol.c",
];

c_include = [
    "native",
    "native/generated",
    "/usr/include/pixman-1",
    "/usr/include/freetype2",
    "/usr/include/harfbuzz",
];

c_defines = [
    "_POSIX_C_SOURCE=200809L",
    "_GNU_SOURCE",
    "GOOT_WITH_GOOSE_H=1",
];

c_flags_cc = [
    "-O2",
    "-Wall",
    "-Wextra",
    "-std=c99",
];

c_libs_linux = [
    "wayland-client",
    "wayland-cursor",
    "pixman-1",
    "freetype",
    "fontconfig",
    "harfbuzz",
    "xkbcommon",
    "m",
];

main_thread_only = true;
output = "goot";
